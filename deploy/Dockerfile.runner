# Runner задачи на релиз: база слайсера (Dockerfile.slicer) + бинарники упаковщика этого коммита (~10 MB слой).
# Собирается на x86-64 (CI на main); glibc bookworm старше Ubuntu 24.04 базы, поэтому бинарники совместимы.
ARG SLICER_IMAGE
FROM rust:1.94.0-bookworm AS packer
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src ./src
ENV CARGO_BUILD_JOBS=3
# Реестр crates и target в кэше BuildKit: повторный релиз пересобирает только изменённое.
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/build/target \
    cargo build --locked --release --bins && mkdir -p /out \
    && cp target/release/colored_3mf_packer target/release/daily_scheduler target/release/verify_outputs /out/

FROM ${SLICER_IMAGE}
LABEL goat-packer=1
COPY --from=packer /out/ /usr/local/bin/
