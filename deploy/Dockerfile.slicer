# База goat-packer-slicer-<kind>:<version>-<hash>: один закреплённый слайсер (Bambu Studio или OrcaSlicer) для linux/amd64.
# Готовый официальный AppImage (не компилируется). build-images.sh скачивает его в кэш, проверяет SHA256 и передаёт
# сюда именованным контекстом `slicer`: пересборка базы не качает 100–200 MB с медленного GitHub заново.
# AppImage монтирует себя через FUSE, а в sandbox задачи FUSE нет, поэтому SquashFS распаковывается заранее
# по закреплённому offset — без запуска файла (работает и на ARM-сборщике).
FROM debian:bookworm-slim AS extract
ARG SLICER_FILE
ARG SLICER_SHA256
ARG SQUASHFS_OFFSET
ARG APT_MIRROR
# Пустой APT_MIRROR = официальные зеркала. CI на main передаёт mirror.yandex.ru: deb.debian.org и
# archive.ubuntu.com оттуда отдают 0.3–5 MB/s против ~30 MB/s.
RUN if [ -n "$APT_MIRROR" ]; then find /etc/apt -name "*.list" -o -name "*.sources" | xargs sed -i -E \
      "s#https?://(deb\.debian\.org|archive\.ubuntu\.com|security\.ubuntu\.com)#$APT_MIRROR#g"; fi
RUN apt-get update && apt-get install -y --no-install-recommends squashfs-tools && rm -rf /var/lib/apt/lists/*
COPY --from=slicer ${SLICER_FILE} /tmp/slicer.AppImage
RUN echo "$SLICER_SHA256  /tmp/slicer.AppImage" | sha256sum -c - \
    && test "$(dd if=/tmp/slicer.AppImage bs=1 skip="$SQUASHFS_OFFSET" count=4 2>/dev/null)" = hsqs \
    && unsquashfs -processors 2 -o "$SQUASHFS_OFFSET" -d /opt/slicer /tmp/slicer.AppImage \
    && rm /tmp/slicer.AppImage

FROM ubuntu:24.04
ARG APT_MIRROR
RUN if [ -n "$APT_MIRROR" ]; then find /etc/apt -name "*.list" -o -name "*.sources" | xargs sed -i -E \
      "s#https?://(deb\.debian\.org|archive\.ubuntu\.com|security\.ubuntu\.com)#$APT_MIRROR#g"; fi
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates libgtk-3-0t64 libwebkit2gtk-4.1-0 libglu1-mesa libgl1 libegl1 libopengl0 \
    libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 libxrender1 libxi6 libxrandr2 libxinerama1 \
    libxss1 libnss3 libsecret-1-0 libnotify4 libasound2t64 libfuse2t64 libxcb-cursor0 \
    locales fonts-dejavu-core xvfb xauth dbus-x11 tini procps coreutils \
    && rm -rf /var/lib/apt/lists/* && locale-gen en_US.UTF-8
RUN getent passwd 1000 >/dev/null || useradd -m -u 1000 runner
COPY --from=extract /opt/slicer /opt/slicer
COPY deploy/runner/slicer.sh /usr/local/bin/slicer
# Профили принтеров указывают /opt/slicers/<kind>/AppRun; оба пути ведут в обёртку с приватным Xvfb.
RUN mkdir -p /opt/slicers/bambu /opt/slicers/orca \
    && ln -s /usr/local/bin/slicer /opt/slicers/bambu/AppRun \
    && ln -s /usr/local/bin/slicer /opt/slicers/orca/AppRun && chmod +x /usr/local/bin/slicer
ENV HOME=/work/home LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 LIBGL_ALWAYS_SOFTWARE=1
WORKDIR /work
USER 1000:1000
ENTRYPOINT []
CMD ["/usr/bin/sleep", "infinity"]
