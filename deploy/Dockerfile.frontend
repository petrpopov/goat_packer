FROM oven/bun:1.3.14 AS build
WORKDIR /src
COPY webapp/frontend/package.json webapp/frontend/bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile
COPY webapp/frontend/ ./
ENV VITE_SERVER_MODE=true
RUN bun run build
FROM nginx:1.28-alpine
LABEL goat-packer=1
COPY --from=build /src/dist /usr/share/nginx/html
# Шаблон: entrypoint nginx подставляет определённые переменные окружения (GOAT_PUBLIC_SCHEME) в conf.d.
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template
ENV GOAT_PUBLIC_SCHEME=""
