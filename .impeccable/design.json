    "typographyMeta": {
      "page-title": {
        "displayName": "Page Title",
        "purpose": "Page headings; auth card uses 22px."
      },
      "title": {
        "displayName": "Title",
        "purpose": "Action-bar file name on the work screen."
      },
      "section": {
        "displayName": "Section",
        "purpose": "Side panel headings."
      },
      "body": {
        "displayName": "Body",
        "purpose": "All copy."
      },
      "label": {
        "displayName": "Label",
        "purpose": "Field labels, buttons, nav, file names."
      },
      "hint": {
        "displayName": "Hint",
        "purpose": "Helper text, table headers, stage list, scene tags."
      },
      "data": {
        "displayName": "Data",
        "purpose": "IDs, durations, mm, counts; tabular figures."
